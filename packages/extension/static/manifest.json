{
  "manifest_version": 3,
  "name": "Shim for Chrome",
  "description": "Runs your shims (personal changes to any website, authored in the Shim browser or with Claude Code) in Chrome.",
  "version": "0.0.0",
  "key": "",
  "minimum_chrome_version": "135",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "scripting",
    "userScripts",
    "storage",
    "webNavigation",
    "debugger",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shim",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sandbox": {
    "pages": [
      "prepare.html"
    ]
  }
}
