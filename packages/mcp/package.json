  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@shimbrowser/core": "0.7.0-dev",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  }
}
